# Codex one-line installer for this platform (Windows PowerShell).
# Usage:  irm __BASE_URL__/install/codex.ps1 | iex
# No Node, no env vars, no token copy-paste: a browser device-flow mints a
# per-device credential and writes it into Codex auth.json.
$ErrorActionPreference = "Stop"

$BaseUrl  = "__BASE_URL__"
$CcshBase = "$BaseUrl/v1"
$CodexHome = if ($env:CODEX_HOME) { $env:CODEX_HOME } else { Join-Path $HOME ".codex" }
$Config = Join-Path $CodexHome "config.toml"
$Auth = Join-Path $CodexHome "auth.json"
New-Item -ItemType Directory -Force -Path $CodexHome | Out-Null

# -- 開始前請注意：先關閉 Codex 桌面版 --------------------------------------
# 執行中的 Codex 桌面版會握住 ~/.codex、可能蓋掉我們寫的設定（無法中途暫停等
# 你關閉，只能在這裡提醒）。
Write-Host "-- 開始前請注意 --"
Write-Host "若你已安裝 Codex 桌面版，請先「完全關閉」它（含 Windows 工作列／系統匣的常駐圖示）再繼續，"
Write-Host "否則執行中的桌面版可能蓋掉這次設定。裝好後再重新開啟即可。"
Write-Host ""

# Back up existing Codex config + auth (timestamped; a re-run never clobbers an
# earlier backup) BEFORE we modify anything. Fail loud if we can't back up.
$ts = Get-Date -Format "yyyyMMdd-HHmmss"
$backedUp = $false
foreach ($f in @($Config, $Auth)) {
  if (Test-Path $f) {
    try { Copy-Item $f "$f.bak-$ts" -Force } catch { Write-Host "ERROR: 無法備份 ${f}（請確認 $CodexHome 可寫）。已中止，未改任何設定。"; exit 1 }
    $backedUp = $true
  }
}
if ($backedUp) { Write-Host "已備份你原本的 Codex 設定為 *.bak-${ts}（在 ${CodexHome}）。" }

# ---------------------------------------------------------------------------
# 1. Codex CLI is OPT-IN. Most people use the Codex desktop app (or an editor
#    extension), which reads ~/.codex directly and does NOT need the CLI binary.
#    Default: SKIP the CLI download (often blocked by SmartScreen / antivirus,
#    and pure waste for desktop users). Opt in with CODEX_WITH_CLI=1 to also
#    install + log in + self-test via the CLI. If `codex` is already on PATH we
#    use it regardless.
# ---------------------------------------------------------------------------
$WantCli = ($env:CODEX_WITH_CLI -eq "1") -or ($args -contains "--cli") -or ($args -contains "--with-cli")
$CodexCli = $false
if (Get-Command codex -ErrorAction SilentlyContinue) {
  $CodexCli = $true  # already installed → use it
} elseif ($WantCli) {
  Write-Host "Installing Codex CLI..."
  $BinDir = Join-Path $HOME ".local\bin"
  New-Item -ItemType Directory -Force -Path $BinDir | Out-Null
  $Url = "https://github.com/openai/codex/releases/latest/download/codex-x86_64-pc-windows-msvc.zip"
  $Zip = Join-Path $env:TEMP "codex.zip"
  try {
    Invoke-WebRequest -Uri $Url -OutFile $Zip
    Expand-Archive -Path $Zip -DestinationPath $BinDir -Force
    if (";$env:PATH;" -notlike "*;$BinDir;*") { $env:PATH = "$BinDir;$env:PATH" }
    if (Get-Command codex -ErrorAction SilentlyContinue) { $CodexCli = $true }
  } catch {
    Write-Host "NOTE: 無法下載／安裝 Codex CLI（可能被網路／防毒 SmartScreen 擋住）；會改用桌面版設定繼續。"
  }
} else {
  Write-Host "（預設略過安裝 Codex CLI；多數人用桌面版即可。若想用 CLI，請先設定 `$env:CODEX_WITH_CLI='1' 再重跑。）"
}

# ---------------------------------------------------------------------------
# 2. Write a CLEAN config.toml for this platform (any prior one was backed up
#    above). A full reset avoids stale leftovers from a previous login/config
#    silently breaking the connection. /model switch still keeps 'ccsh'; no
#    read-only config, no wrapper/alias.
# ---------------------------------------------------------------------------
$block = @"
model_provider = "ccsh"

[model_providers.ccsh]
name = "CCSH"
base_url = "$CcshBase"
wire_api = "responses"
requires_openai_auth = true
supports_websockets = false
"@
Set-Content -Path $Config -Value $block
Write-Host "Wrote $Config (clean platform config; provider 'ccsh' -> $CcshBase)"

# ---------------------------------------------------------------------------
# 3. Device-flow: authorize in the browser, no token copy-paste.
# ---------------------------------------------------------------------------
$label = "Codex on $env:COMPUTERNAME"
$auth = Invoke-RestMethod -Method Post -Uri "$BaseUrl/device/authorize" `
  -ContentType "application/json" -Body (@{ device_label = $label } | ConvertTo-Json)
$deviceCode = $auth.device_code
$userCode   = $auth.user_code
$interval   = if ($auth.interval) { [int]$auth.interval } else { 5 }

Write-Host ""
Write-Host "  Open this page in your browser (you must be logged in):"
Write-Host "    $BaseUrl/device?code=$userCode"
Write-Host "  and confirm the code:  $userCode"
Write-Host ""
Write-Host "Waiting for authorization..."

$token = ""
while (-not $token) {
  Start-Sleep -Seconds $interval
  try {
    $resp = Invoke-RestMethod -Method Post -Uri "$BaseUrl/device/token" `
      -ContentType "application/json" -Body (@{ device_code = $deviceCode } | ConvertTo-Json)
    if ($resp.token) { $token = $resp.token }
  } catch {
    $err = ""
    try { $err = ($_.ErrorDetails.Message | ConvertFrom-Json).error } catch {}
    if ($err -eq "expired_token") { Write-Host "ERROR: the code expired. Re-run this command."; exit 1 }
    if ($err -eq "access_denied") { Write-Host "Authorization was denied."; exit 1 }
    # authorization_pending / slow_down -> keep waiting
  }
}

# The same success response carries the model this key is scoped to.
$defaultModel = if ($resp.model) { [string]$resp.model } else { "" }

# ---------------------------------------------------------------------------
# 4. Pin the default model (no CLI needed — also helps the desktop App), then
#    store the key in auth.json and verify over HTTPS. The CLI is optional: when
#    present we also run `codex login`, but the desktop-app path never needs it.
# ---------------------------------------------------------------------------
# Pin Codex's default model to the one this key grants, so plain `codex` uses
# your model instead of Codex's built-in default. Switch anytime with /model.
if ($defaultModel) {
  $cfg = ""
  if (Test-Path $Config) { $cfg = Get-Content -Raw $Config }
  $cfg = [regex]::Replace($cfg, '(?m)^\s*model\s*=.*\r?\n?', '')  # drop any prior top-level model
  Set-Content -Path $Config -Value ("model = `"$defaultModel`"`n" + $cfg.TrimStart())
  Write-Host "Default model set to $defaultModel (switch anytime with /model)."
}

# Write auth.json ({"OPENAI_API_KEY": ...}) directly so the desktop app, an
# editor extension, or a later CLI all pick up the key with NO manual entry.
# (Any prior auth.json was backed up above; the restore script puts it back.)
Set-Content -Path $Auth -Value (@{ OPENAI_API_KEY = $token } | ConvertTo-Json -Compress)
Write-Host "Wrote $Auth (key stored for the desktop app / CLI)."

if ($CodexCli) {
  # CLI present: clear any prior login (e.g. a ChatGPT account) so our API key
  # wins, then log in via the CLI's own authoritative store. Safe no-op if not
  # logged in.
  try { codex logout 2>$null | Out-Null } catch {}
  try { $token | codex login --with-api-key | Out-Null } catch {}
}

# Verify the key against the gateway over plain HTTPS — works without the CLI,
# and catches "configured but never actually connected".
Write-Host "Verifying connection..."
$verified = $false
try {
  Invoke-RestMethod -Method Get -Uri "$CcshBase/models" -Headers @{ Authorization = "Bearer $token" } | Out-Null
  $verified = $true
} catch {}
if ($verified) {
  if ($CodexCli) {
    Write-Host "OK - 連線與金鑰已驗證，在任何新終端機執行 'codex' 即可開始。"
  } else {
    Write-Host "OK - 連線與金鑰已驗證，開啟 Codex 桌面版（或編輯器的 Codex 擴充）即可開始，它會讀取剛寫入的設定。"
  }
} else {
  # Self-test failed: hand over the key so the member can still finish manually.
  Write-Host ""
  Write-Host "WARNING: 設定已寫入，但自我測試沒通過（可能是網路／防火牆，或金鑰問題）。"
  Write-Host "  你的平台金鑰（只顯示這一次，請立刻複製保存）："
  Write-Host ""
  Write-Host "    $token"
  Write-Host ""
  Write-Host "  可改用這把金鑰手動完成（二選一）："
  Write-Host "  1) 裝好 Codex CLI 後執行（把 <KEY> 換成金鑰）："
  Write-Host "       `$env:KEY='<KEY>'; `$env:KEY | codex login --with-api-key"
  Write-Host "  2) Codex 桌面 App：在 App 設定填入上面的金鑰當 API key（provider 已指向本平台）。"
}

if ($backedUp) { Write-Host "（要還原舊設定：把 $CodexHome 內的 *.bak-$ts 改回原本檔名即可。）" }
