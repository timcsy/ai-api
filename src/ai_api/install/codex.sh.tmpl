#!/bin/sh
# Codex one-line installer for this platform (macOS / Linux).
# Usage:  curl -fsSL __BASE_URL__/install/codex.sh | sh
# No Node, no env vars, no token copy-paste: a browser device-flow mints a
# per-device credential and writes it into Codex auth.json.
set -eu

BASE_URL="__BASE_URL__"
CCSH_BASE="$BASE_URL/v1"
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
CONFIG="$CODEX_HOME/config.toml"
mkdir -p "$CODEX_HOME"

say() { printf '%s\n' "$*"; }
need() { command -v "$1" >/dev/null 2>&1 || { say "ERROR: '$1' is required but not found."; exit 1; }; }
need curl
need python3

AUTH="$CODEX_HOME/auth.json"

# ── 開始前請注意：先關閉 Codex 桌面版 ─────────────────────────────────────
# 執行中的 Codex 桌面版會握住 ~/.codex、可能蓋掉我們寫的設定（curl|sh 無法
# 中途暫停等你關閉，只能在這裡提醒）。
say "── 開始前請注意 ──"
say "若你已安裝 Codex 桌面版，請先「完全關閉」它（含 Windows 工作列／系統匣的常駐圖示）再繼續，"
say "否則執行中的桌面版可能蓋掉這次設定。裝好後再重新開啟即可。"
say ""

# Back up existing Codex config + auth (timestamped; a re-run never clobbers an
# earlier backup) BEFORE we modify anything. Fail loud if we can't back up.
TS="$(date +%Y%m%d-%H%M%S 2>/dev/null || echo backup)"
BACKED_UP=0
for f in "$CONFIG" "$AUTH"; do
  if [ -f "$f" ]; then
    cp "$f" "$f.bak-$TS" || { say "ERROR: 無法備份 ${f}（請確認 $CODEX_HOME 可寫）。已中止，未改任何設定。"; exit 1; }
    BACKED_UP=1
  fi
done
[ "$BACKED_UP" = "1" ] && say "已備份你原本的 Codex 設定為 *.bak-${TS}（在 ${CODEX_HOME}）。"

# ---------------------------------------------------------------------------
# 1. Codex CLI is OPT-IN. Most people use the Codex desktop app (or an editor
#    extension), which reads ~/.codex directly and does NOT need the CLI binary.
#    Default: SKIP the CLI download (a large GitHub download that antivirus /
#    networks often block, and pure waste for desktop users). Opt in with
#    `--cli` (or CODEX_WITH_CLI=1) to also install + log in + self-test via the
#    CLI. If `codex` is already on PATH we use it regardless.
# ---------------------------------------------------------------------------
WANT_CLI=0
case "${1:-}" in --cli|--with-cli) WANT_CLI=1 ;; esac
[ "${CODEX_WITH_CLI:-}" = "1" ] && WANT_CLI=1

CODEX_CLI=0
if command -v codex >/dev/null 2>&1; then
  CODEX_CLI=1  # already installed → use it
elif [ "$WANT_CLI" = "1" ]; then
  say "Installing Codex CLI..."
  OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
  ARCH="$(uname -m)"
  case "$ARCH" in x86_64|amd64) ARCH=x86_64 ;; arm64|aarch64) ARCH=aarch64 ;; esac
  TARGET=""
  case "$OS" in
    darwin) TARGET="${ARCH}-apple-darwin" ;;
    linux)  TARGET="${ARCH}-unknown-linux-musl" ;;
  esac
  if [ -z "$TARGET" ]; then
    say "NOTE: 無法自動安裝 Codex CLI（不支援的系統 '${OS}'）；會改用桌面版設定繼續。"
  else
    BIN_DIR="$HOME/.local/bin"; mkdir -p "$BIN_DIR"
    URL="https://github.com/openai/codex/releases/latest/download/codex-${TARGET}.tar.gz"
    if curl -fsSL "$URL" | tar -xz -C "$BIN_DIR" 2>/dev/null; then
      # Some archives unpack to codex-<target>; normalise to 'codex'.
      [ -f "$BIN_DIR/codex-${TARGET}" ] && mv "$BIN_DIR/codex-${TARGET}" "$BIN_DIR/codex"
      chmod +x "$BIN_DIR/codex" 2>/dev/null || true
      case ":$PATH:" in *":$BIN_DIR:"*) : ;; *) PATH="$BIN_DIR:$PATH"; export PATH ;; esac
      CODEX_CLI=1
    else
      say "NOTE: 無法下載 Codex CLI（可能被網路／防毒擋住）；會改用桌面版設定繼續。"
    fi
  fi
else
  say "（預設略過安裝 Codex CLI；多數人用桌面版即可。若想用 CLI，請在指令結尾加上 --cli 重跑。）"
fi
# A download may still not be runnable — re-check.
command -v codex >/dev/null 2>&1 || CODEX_CLI=0

# ---------------------------------------------------------------------------
# 2. Write a CLEAN config.toml for this platform (any prior one was backed up
#    above). A full reset avoids stale leftovers from a previous login/config
#    silently breaking the connection. /model switch still keeps 'ccsh'; no
#    read-only config, no wrapper/alias.
# ---------------------------------------------------------------------------
cat > "$CONFIG" <<EOF
model_provider = "ccsh"

[model_providers.ccsh]
name = "CCSH"
base_url = "$CCSH_BASE"
wire_api = "responses"
requires_openai_auth = true
supports_websockets = false
EOF
say "Wrote $CONFIG (clean platform config; provider 'ccsh' -> $CCSH_BASE)"

# ---------------------------------------------------------------------------
# 3. Device-flow: authorize in the browser, no token copy-paste.
# ---------------------------------------------------------------------------
# NOTE: use a distinct name for the authorize RESPONSE — $AUTH is the auth.json
# PATH (set above, written in step 4). Reusing $AUTH here would clobber it.
LABEL="Codex on $(hostname 2>/dev/null || echo device)"
DEV_AUTH=$(curl -fsSL -X POST "$BASE_URL/device/authorize" \
  -H 'Content-Type: application/json' -d "{\"device_label\":\"$LABEL\"}")
DEVICE_CODE=$(printf '%s' "$DEV_AUTH" | python3 -c 'import sys,json;print(json.load(sys.stdin)["device_code"])')
USER_CODE=$(printf '%s' "$DEV_AUTH" | python3 -c 'import sys,json;print(json.load(sys.stdin)["user_code"])')
INTERVAL=$(printf '%s' "$DEV_AUTH" | python3 -c 'import sys,json;print(json.load(sys.stdin)["interval"])')

say ""
say "  Open this page in your browser (you must be logged in):"
say "    $BASE_URL/device?code=$USER_CODE"
say "  and confirm the code:  $USER_CODE"
say ""
say "Waiting for authorization..."

TOKEN=""
while [ -z "$TOKEN" ]; do
  sleep "${INTERVAL:-5}"
  RESP=$(curl -s -X POST "$BASE_URL/device/token" \
    -H 'Content-Type: application/json' -d "{\"device_code\":\"$DEVICE_CODE\"}")
  TOKEN=$(printf '%s' "$RESP" | python3 -c 'import sys,json;d=json.load(sys.stdin);print(d.get("token",""))' 2>/dev/null || true)
  ERR=$(printf '%s' "$RESP" | python3 -c 'import sys,json;d=json.load(sys.stdin);print(d.get("error",""))' 2>/dev/null || true)
  case "$ERR" in
    expired_token) say "ERROR: the code expired. Re-run this command."; exit 1 ;;
    access_denied) say "Authorization was denied."; exit 1 ;;
  esac
done

# The same success response carries the model this key is scoped to.
MODEL=$(printf '%s' "$RESP" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("model") or "")' 2>/dev/null || true)

# ---------------------------------------------------------------------------
# 4. Pin the default model (no CLI needed — also helps the desktop App), then
#    store the key in auth.json and verify over HTTPS. The CLI is optional: when
#    present we also run `codex login`, but the desktop-app path never needs it.
# ---------------------------------------------------------------------------
# Pin Codex's default model to the one this key grants, so plain `codex` uses
# your model instead of Codex's built-in default. Switch anytime with /model.
if [ -n "$MODEL" ]; then
  python3 - "$CONFIG" "$MODEL" <<'PY'
import sys, re, pathlib
cfg, model = pathlib.Path(sys.argv[1]), sys.argv[2]
text = cfg.read_text() if cfg.exists() else ""
text = re.sub(r'(?m)^\s*model\s*=.*$\n?', '', text)  # drop any prior top-level model
cfg.write_text(f'model = "{model}"\n' + text.lstrip())
PY
  say "Default model set to $MODEL (switch anytime with /model)."
fi

# Write auth.json ({"OPENAI_API_KEY": ...}) directly so the desktop app, an
# editor extension, or a later CLI all pick up the key with NO manual entry.
# (Any prior auth.json was backed up above; the restore script puts it back.)
python3 - "$AUTH" "$TOKEN" <<'PY'
import json, pathlib, sys
pathlib.Path(sys.argv[1]).write_text(json.dumps({"OPENAI_API_KEY": sys.argv[2]}) + "\n")
PY
say "Wrote ${AUTH} (key stored for the desktop app / CLI)."

if [ "$CODEX_CLI" = "1" ]; then
  # CLI present: clear any prior login (e.g. a ChatGPT account) so our API key
  # wins, then log in via the CLI's own authoritative store. Safe no-op if not
  # logged in.
  codex logout >/dev/null 2>&1 || true
  printf '%s' "$TOKEN" | codex login --with-api-key >/dev/null 2>&1 || true
fi

# Verify the key against the gateway over plain HTTPS — works without the CLI,
# and catches "configured but never actually connected".
say "Verifying connection..."
if curl -fsS "$CCSH_BASE/models" -H "Authorization: Bearer $TOKEN" >/dev/null 2>&1; then
  if [ "$CODEX_CLI" = "1" ]; then
    say "✓ 連線與金鑰已驗證 — 在任何新終端機執行 'codex' 即可開始。"
  else
    say "✓ 連線與金鑰已驗證 — 開啟 Codex 桌面版（或編輯器的 Codex 擴充）即可開始，它會讀取剛寫入的設定。"
  fi
else
  # Self-test failed: hand over the key so the member can still finish manually.
  say ""
  say "⚠ 設定已寫入，但自我測試沒通過（可能是網路／防火牆，或金鑰問題）。"
  say "  你的平台金鑰（只顯示這一次，請立刻複製保存）："
  say ""
  say "    ${TOKEN}"
  say ""
  say "  可改用這把金鑰手動完成（二選一）："
  say "  1) 裝好 Codex CLI 後執行（把 <KEY> 換成金鑰）："
  say "       printf '%s' '<KEY>' | codex login --with-api-key"
  say "  2) Codex 桌面 App：在 App 設定填入上面的金鑰當 API key（provider 已指向本平台）。"
fi

[ "$BACKED_UP" = "1" ] && say "（要還原舊設定：把 $CODEX_HOME 內的 *.bak-$TS 改回原本檔名即可。）"
